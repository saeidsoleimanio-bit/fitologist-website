# Lead delivery for /api/lead (FITOLOGIST_SPEC.md §6.4).
# Copy to .env.local for local testing; on Vercel add them under Project → Settings → Environment Variables.
# Never commit real values. These are read on the server only (no NEXT_PUBLIC_ prefix).

# Telegram bot that notifies you of every new lead (from @BotFather)
TELEGRAM_BOT_TOKEN=
# Your chat id with that bot (see SETUP_LEADS.md)
TELEGRAM_CHAT_ID=

# Google Apps Script web app URL that appends a row to your lead sheet (scripts/sheets-webhook.gs)
SHEETS_WEBHOOK_URL=

# Optional — only for local testing against a mock server. Leave empty in production.
TELEGRAM_API_BASE=
